# Base URL of the gascurve api (REST). The WebSocket URL is derived from it
# (http -> ws, path /ws) unless NEXT_PUBLIC_WS_URL is set.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws
# Canonical origin of the deployment. Canonical links, the sitemap, robots.txt
# and the social card URLs are resolved against it. Defaults to
# https://gascurve.com, which is what Dockerfile.web bakes in.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Serve a deterministic in-browser mock of the api and WebSocket instead of a backend.
# NEXT_PUBLIC_USE_MOCK_DATA=true
