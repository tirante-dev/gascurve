# syntax=docker/dockerfile:1

# Base images are pinned by digest; Dependabot (docker ecosystem) bumps them.
FROM golang:1.26-alpine@sha256:ce864e7223ac17b1775e6fd0b4c0db580c2eb50e7953a427916379e4b92a1628 AS builder
WORKDIR /src
ARG VERSION=0.0.0
RUN apk add --no-cache ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/tirante-dev/gascurve/internal/version.Version=${VERSION}" -o /out/gascurve-api ./cmd/api \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/tirante-dev/gascurve/internal/version.Version=${VERSION}" -o /out/gascurve-migrate ./cmd/migrate

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
WORKDIR /app
COPY --from=builder /out/gascurve-api /app/gascurve-api
COPY --from=builder /out/gascurve-migrate /app/gascurve-migrate
COPY config.yaml /app/config.yaml
# Numeric UID/GID so Kubernetes can enforce runAsNonRoot (distroless nonroot is 65532).
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/gascurve-api"]
