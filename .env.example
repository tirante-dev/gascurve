# Copy to .env for local development. Values here override config.yaml.
DB_URL=postgres://postgres:postgres@127.0.0.1:5432/gascurve?sslmode=disable
PORT=8080
LOG_LEVEL=info
DEV_MODE=true
CONFIG_PATH=config.yaml

# ETH/USD spot the collector's slow loop fetches (server side; the browser
# never calls a price API). coinbase (default), coingecko, or an https URL
# answering JSON with a top-level price. Set it empty to disable the fetch:
# every snapshot then reports ethUsd: null. ETH_USD_MAX_AGE is how long a
# quote stays in the snapshot before it is reported as null (default 10m).
# ETH_USD_SOURCE=coinbase
# ETH_USD_MAX_AGE=10m

# Per-network overrides: NETWORK_<NAME>_RPC_URL, NETWORK_<NAME>_ENABLED,
# NETWORK_<NAME>_CALLS_PER_SECOND (0 = unlimited, for dedicated nodes),
# NETWORK_<NAME>_WS_URL, NETWORK_<NAME>_ARCHIVE, NETWORK_<NAME>_TICK_INTERVAL (e.g. 250ms on a dedicated node). Names are upper-cased with
# dashes as underscores, e.g. NETWORK_ROBINHOOD_RPC_URL, NETWORK_ARBITRUM_ONE_ENABLED.
NETWORK_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Fallback endpoints per network: comma-separated, positional lists (item i
# describes fallback i; an empty item leaves that field unset, missing items
# keep zero values). Keyed URLs belong here, never in config.yaml.
#   NETWORK_<NAME>_FALLBACK_RPC_URLS          https URLs, one per fallback (required)
#   NETWORK_<NAME>_FALLBACK_WS_URLS           ws:// or wss:// URLs, "" for none
#   NETWORK_<NAME>_FALLBACK_ARCHIVE           true/false per fallback
#   NETWORK_<NAME>_FALLBACK_CALLS_PER_SECOND  budget per fallback, 0 = unlimited
# One QuickNode fallback for Robinhood with WebSocket and archive state:
# NETWORK_ROBINHOOD_FALLBACK_RPC_URLS=https://<name>.robinhood-mainnet.quiknode.pro/<key>/
# NETWORK_ROBINHOOD_FALLBACK_WS_URLS=wss://<name>.robinhood-mainnet.quiknode.pro/<key>/
# NETWORK_ROBINHOOD_FALLBACK_ARCHIVE=true
# NETWORK_ROBINHOOD_FALLBACK_CALLS_PER_SECOND=0

# Web (web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws
