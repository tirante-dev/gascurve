# Copy to .env for local development. Values here override config.yaml.
DB_URL=postgres://postgres:postgres@127.0.0.1:5432/gascurve?sslmode=disable
PORT=8080
LOG_LEVEL=info
DEV_MODE=true
CONFIG_PATH=config.yaml

# Per-network overrides: NETWORK_<NAME>_RPC_URL, NETWORK_<NAME>_ENABLED,
# NETWORK_<NAME>_CALLS_PER_SECOND. Names are upper-cased with dashes as
# underscores, e.g. NETWORK_ROBINHOOD_RPC_URL, NETWORK_ARBITRUM_ONE_ENABLED.
NETWORK_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Web (web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws
