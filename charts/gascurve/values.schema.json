{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "gascurve values",
  "description": "Validated by helm install, upgrade, template and lint. A database is mandatory whenever the collector or the api is enabled: set exactly one of database.url (rendered into a Secret) and database.existingSecret. Every network the collector runs also needs a primary RPC URL, from config.networks[].rpc_url or a collector.extraEnv entry named NETWORK_<NAME>_RPC_URL; that cross-reference is checked by the templates, not here.",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string", "minLength": 1 } },
            "required": ["name"]
          }
        }
      },
      "required": ["registry", "pullPolicy"]
    },
    "collector": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/componentImage" },
        "securityContext": { "$ref": "#/definitions/componentSecurityContext" },
        "resources": { "type": "object" },
        "extraEnv": { "$ref": "#/definitions/envVarList" }
      },
      "required": ["enabled", "image"]
    },
    "api": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/componentImage" },
        "securityContext": { "$ref": "#/definitions/componentSecurityContext" },
        "service": { "$ref": "#/definitions/service" },
        "resources": { "type": "object" },
        "extraEnv": { "$ref": "#/definitions/envVarList" }
      },
      "required": ["enabled", "image", "service"]
    },
    "web": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/componentImage" },
        "securityContext": { "$ref": "#/definitions/componentSecurityContext" },
        "service": { "$ref": "#/definitions/service" },
        "resources": { "type": "object" }
      },
      "required": ["enabled", "image", "service"]
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "host": { "type": "string" },
        "tls": { "type": "array" }
      },
      "required": ["enabled"],
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "properties": { "host": { "type": "string", "minLength": 1 } }, "required": ["host"] }
    },
    "database": {
      "type": "object",
      "description": "Exactly one of url and existingSecret must be non-empty when collector.enabled or api.enabled.",
      "properties": {
        "url": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      },
      "required": ["url", "existingSecret", "existingSecretKey"]
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "securityContext": { "$ref": "#/definitions/componentSecurityContext" },
        "resources": { "type": "object" },
        "extraEnv": { "$ref": "#/definitions/envVarList" }
      },
      "required": ["enabled"]
    },
    "config": {
      "type": "object",
      "properties": {
        "server": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "cors_origins": { "type": "array", "items": { "type": "string" } },
            "dev_mode": { "type": "boolean" }
          },
          "required": ["port"]
        },
        "database": { "type": "object" },
        "collector": { "type": "object" },
        "networks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "chain_id": { "type": "integer", "minimum": 1 },
              "rpc_url": {
                "type": "string",
                "minLength": 1,
                "description": "Primary RPC URL. Omit it only when the collector's environment supplies NETWORK_<NAME>_RPC_URL, which the templates check."
              },
              "enabled": { "type": "boolean" }
            },
            "required": ["name", "chain_id"]
          }
        }
      },
      "required": ["server", "networks"]
    },
    "extraEnv": {
      "description": "Deprecated alias applied to the collector, api and migration containers alike. Use collector.extraEnv, api.extraEnv and migrations.extraEnv instead.",
      "$ref": "#/definitions/envVarList"
    },
    "logLevel": { "type": "string", "pattern": "^(?i)(debug|info|warn|error)$" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "automountServiceAccountToken": { "type": "boolean" }
      },
      "required": ["create"]
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  },
  "required": ["image", "collector", "api", "web", "ingress", "database", "migrations", "config", "serviceAccount"],
  "if": {
    "anyOf": [
      { "properties": { "collector": { "properties": { "enabled": { "const": true } } } } },
      { "properties": { "api": { "properties": { "enabled": { "const": true } } } } }
    ]
  },
  "then": {
    "properties": {
      "database": {
        "oneOf": [
          {
            "title": "database.url set, database.existingSecret empty",
            "properties": {
              "url": { "type": "string", "minLength": 1 },
              "existingSecret": { "type": "string", "maxLength": 0 }
            }
          },
          {
            "title": "database.existingSecret set, database.url empty",
            "properties": {
              "url": { "type": "string", "maxLength": 0 },
              "existingSecret": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "componentImage": {
      "type": "object",
      "properties": { "repository": { "type": "string", "minLength": 1 } },
      "required": ["repository"]
    },
    "componentSecurityContext": {
      "type": "object",
      "properties": {
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "required": ["type", "port"]
    },
    "keySelector": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" }
      },
      "required": ["name", "key"],
      "additionalProperties": false
    },
    "envVar": {
      "title": "Kubernetes EnvVar",
      "description": "A name plus exactly one of value and valueFrom. valueFrom holds exactly one of secretKeyRef, configMapKeyRef, fieldRef and resourceFieldRef.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "^[-._a-zA-Z][-._a-zA-Z0-9]*$" },
        "value": { "type": "string" },
        "valueFrom": {
          "type": "object",
          "properties": {
            "secretKeyRef": { "$ref": "#/definitions/keySelector" },
            "configMapKeyRef": { "$ref": "#/definitions/keySelector" },
            "fieldRef": {
              "type": "object",
              "properties": {
                "apiVersion": { "type": "string", "minLength": 1 },
                "fieldPath": { "type": "string", "minLength": 1 }
              },
              "required": ["fieldPath"],
              "additionalProperties": false
            },
            "resourceFieldRef": {
              "type": "object",
              "properties": {
                "containerName": { "type": "string", "minLength": 1 },
                "resource": { "type": "string", "minLength": 1 },
                "divisor": { "type": ["string", "integer", "number"] }
              },
              "required": ["resource"],
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1
        }
      },
      "required": ["name"],
      "additionalProperties": false,
      "oneOf": [
        { "title": "value", "required": ["value"], "not": { "required": ["valueFrom"] } },
        { "title": "valueFrom", "required": ["valueFrom"], "not": { "required": ["value"] } }
      ]
    },
    "envVarList": { "type": "array", "items": { "$ref": "#/definitions/envVar" } }
  }
}
