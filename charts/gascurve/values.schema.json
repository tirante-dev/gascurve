{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "gascurve values",
  "description": "Validated by helm install, upgrade, template and lint. A database is mandatory whenever the collector or the api is enabled: set exactly one of database.url (rendered into a Secret) and database.existingSecret. Ingress needs at least one backend, and ingress with the api needs at least one explicit trusted proxy address or CIDR so client rate limits do not collapse onto the ingress address. The config object is the application's own configuration and is modelled here field by field, because a value the chart accepts and the binary then rejects only shows up as a crash-looping pod: durations are Go durations, budgets are 0 (unlimited) or 0.1 to 10000 calls per second, ws_url values are ws:// or wss://, and chart-owned objects reject unknown keys so a misplaced field cannot be silently ignored. What cannot be expressed here is the cross-reference between a network without an rpc_url and a NETWORK_<NAME>_RPC_URL entry in the collector's environment; the templates check that.",
  "type": "object",
  "properties": {
    "global": {
      "description": "Reserved by Helm for values shared with subcharts. This chart has none and reads nothing from it.",
      "type": "object"
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string", "minLength": 1 } },
            "required": ["name"],
            "additionalProperties": false
          }
        }
      },
      "required": ["registry", "pullPolicy"],
      "additionalProperties": false
    },
    "collector": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/componentImage" },
        "securityContext": { "$ref": "#/definitions/componentSecurityContext" },
        "resources": { "$ref": "#/definitions/resources" },
        "extraEnv": { "$ref": "#/definitions/envVarList" }
      },
      "required": ["enabled", "image"],
      "additionalProperties": false
    },
    "api": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/componentImage" },
        "securityContext": { "$ref": "#/definitions/componentSecurityContext" },
        "service": { "$ref": "#/definitions/service" },
        "networkPolicy": {
          "type": "object",
          "description": "Ingress isolation for API pods. It is rendered only when both the api and chart-managed ingress are enabled.",
          "properties": {
            "enabled": { "type": "boolean" },
            "allowedPeers": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/networkPolicyPeer" }
            }
          },
          "required": ["enabled", "allowedPeers"],
          "additionalProperties": false
        },
        "resources": { "$ref": "#/definitions/resources" },
        "extraEnv": { "$ref": "#/definitions/envVarList" }
      },
      "required": ["enabled", "image", "service", "networkPolicy"],
      "additionalProperties": false
    },
    "web": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/componentImage" },
        "securityContext": { "$ref": "#/definitions/componentSecurityContext" },
        "service": { "$ref": "#/definitions/service" },
        "resources": { "$ref": "#/definitions/resources" }
      },
      "required": ["enabled", "image", "service"],
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "host": { "type": "string" },
        "tls": { "type": "array" }
      },
      "required": ["enabled"],
      "additionalProperties": false,
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "properties": { "host": { "type": "string", "minLength": 1 } }, "required": ["host"] }
    },
    "database": {
      "type": "object",
      "description": "Exactly one of url and existingSecret must be non-empty when collector.enabled or api.enabled.",
      "properties": {
        "url": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      },
      "required": ["url", "existingSecret", "existingSecretKey"],
      "additionalProperties": false
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "securityContext": { "$ref": "#/definitions/componentSecurityContext" },
        "resources": { "$ref": "#/definitions/resources" },
        "extraEnv": { "$ref": "#/definitions/envVarList" }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "config": {
      "description": "Rendered verbatim into config.yaml and read by internal/config. Every field the binary understands is listed; unknown keys are rejected rather than mounted and ignored.",
      "type": "object",
      "properties": {
        "server": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "cors_origins": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "dev_mode": { "type": "boolean" },
            "rate_limit_per_second": { "type": "number", "exclusiveMinimum": 0 },
            "rate_limit_burst": { "type": "integer", "minimum": 1 },
            "trusted_proxies": {
              "description": "Addresses or CIDRs of reverse proxies whose X-Forwarded-For is believed. Required when both ingress and api are enabled.",
              "type": "array",
              "items": { "$ref": "#/definitions/ipAddressOrCIDR" }
            },
            "ws_max_per_ip": { "type": "integer", "minimum": 1 },
            "ws_max_total": { "type": "integer", "minimum": 1 }
          },
          "required": ["port"],
          "additionalProperties": false
        },
        "database": {
          "description": "Pool settings only. The connection string always arrives as DB_URL from database.url or database.existingSecret, so it is never written into the ConfigMap.",
          "type": "object",
          "properties": {
            "max_open": { "type": "integer", "minimum": 1 },
            "max_idle": { "type": "integer", "minimum": 0 },
            "run_migrations": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "collector": {
          "type": "object",
          "properties": {
            "metrics_port": {
              "description": "Port for the collector's own HTTP server, which serves /metrics and nothing else. 0 disables it, and the collector's Service and ServiceMonitor are then not rendered. Overridden by METRICS_PORT.",
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "tick_interval": { "$ref": "#/definitions/duration" },
            "slow_interval": { "$ref": "#/definitions/duration" },
            "header_batch_size": { "type": "integer", "minimum": 1, "maximum": 100 },
            "block_retention": { "$ref": "#/definitions/duration" },
            "sample_retention": { "$ref": "#/definitions/duration" },
            "backfill_depth": { "$ref": "#/definitions/duration" },
            "backfill_anchor_interval": { "type": "integer", "minimum": 1 },
            "max_catch_up_batches": { "type": "integer", "minimum": 1 },
            "failover_cooldown": { "$ref": "#/definitions/duration" },
            "eth_usd_source": {
              "description": "\"\" disables the ETH/USD fetch (every snapshot then reports ethUsd: null), coinbase and coingecko are the built-in providers, and any other value must be an https URL answering JSON with a top-level price. Overridden by ETH_USD_SOURCE, where an empty value is meaningful too.",
              "type": "string",
              "anyOf": [
                { "title": "disabled or a built-in provider", "enum": ["", "coinbase", "coingecko"] },
                { "title": "https URL", "pattern": "^https://[^\\s]+$" }
              ]
            },
            "eth_usd_max_age": { "$ref": "#/definitions/duration" }
          },
          "additionalProperties": false
        },
        "networks": {
          "type": "array",
          "items": { "$ref": "#/definitions/network" }
        }
      },
      "required": ["server", "networks"],
      "additionalProperties": false
    },
    "metrics": {
      "description": "Prometheus operator objects. Both binaries serve /metrics whatever is set here; these are the ServiceMonitor and PrometheusRule that tell an operator about them, and they need those CRDs, so both default to false.",
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object" },
            "interval": { "$ref": "#/definitions/promDuration" },
            "scrapeTimeout": { "$ref": "#/definitions/promDuration" }
          },
          "required": ["enabled"],
          "additionalProperties": false
        },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object" },
            "alertLabels": { "type": "object" },
            "dedicatedNetworks": {
              "description": "Regular expression on the network label naming the networks that follow a dedicated endpoint. They get the tight lag threshold; every other network gets the loose one.",
              "type": "string",
              "minLength": 1
            },
            "alerts": {
              "type": "object",
              "properties": {
                "collectorLagDedicated": { "$ref": "#/definitions/alert" },
                "collectorLagPublic": { "$ref": "#/definitions/alert" },
                "collectorSampleStale": { "$ref": "#/definitions/alert" },
                "collectorRateLimited": { "$ref": "#/definitions/alert" },
                "collectorEndpointsExhausted": { "$ref": "#/definitions/alert" },
                "collectorDown": { "$ref": "#/definitions/alert" },
                "apiDown": { "$ref": "#/definitions/alert" },
                "apiErrorRate": { "$ref": "#/definitions/alert" },
                "databaseUnreachable": { "$ref": "#/definitions/alert" }
              },
              "additionalProperties": false
            }
          },
          "required": ["enabled"],
          "additionalProperties": false
        }
      },
      "required": ["serviceMonitor", "prometheusRule"],
      "additionalProperties": false
    },
    "extraEnv": {
      "description": "Deprecated alias applied to the collector, api and migration containers alike. Use collector.extraEnv, api.extraEnv and migrations.extraEnv instead.",
      "$ref": "#/definitions/envVarList"
    },
    "logLevel": { "type": "string", "pattern": "^(?i)(debug|info|warn|error)$" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "automountServiceAccountToken": { "type": "boolean" }
      },
      "required": ["create"],
      "additionalProperties": false
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  },
  "required": ["image", "collector", "api", "web", "ingress", "database", "migrations", "config", "metrics", "serviceAccount"],
  "additionalProperties": false,
  "allOf": [
    {
      "title": "a database is required when the collector or the api is enabled",
      "if": {
        "anyOf": [
          { "properties": { "collector": { "properties": { "enabled": { "const": true } } } } },
          { "properties": { "api": { "properties": { "enabled": { "const": true } } } } }
        ]
      },
      "then": {
        "properties": {
          "database": {
            "oneOf": [
              {
                "title": "database.url set, database.existingSecret empty",
                "properties": {
                  "url": { "type": "string", "minLength": 1 },
                  "existingSecret": { "type": "string", "maxLength": 0 }
                }
              },
              {
                "title": "database.existingSecret set, database.url empty",
                "properties": {
                  "url": { "type": "string", "maxLength": 0 },
                  "existingSecret": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    },
    {
      "title": "ingress needs a backend: enable api or web, or disable ingress",
      "if": {
        "properties": {
          "ingress": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "api": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
          "web": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] }
        },
        "required": ["ingress", "api", "web"]
      },
      "then": {
        "properties": {
          "ingress": {
            "title": "ingress.enabled must be false while both api.enabled and web.enabled are false, because the Ingress would have no HTTP paths",
            "properties": { "enabled": { "const": false } }
          }
        }
      }
    },
    {
      "title": "ingress with the api needs an explicit trusted proxy address or CIDR",
      "if": {
        "properties": {
          "ingress": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "api": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }
        },
        "required": ["ingress", "api"]
      },
      "then": {
        "properties": {
          "config": {
            "properties": {
              "server": {
                "title": "config.server.trusted_proxies must name every trusted reverse proxy hop when ingress and api are enabled",
                "properties": { "trusted_proxies": { "minItems": 1 } },
                "required": ["trusted_proxies"]
              }
            },
            "required": ["server"]
          }
        }
      }
    }
  ],
  "definitions": {
    "ipAddressOrCIDR": {
      "title": "IP address or CIDR",
      "description": "An IPv4 or IPv6 address, optionally followed by its prefix length.",
      "type": "string",
      "anyOf": [
        { "title": "IPv4 address or CIDR", "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})(/(3[0-2]|[12]?[0-9]))?$" },
        { "title": "IPv6 address or CIDR", "pattern": "^[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]+(/(12[0-8]|1[01][0-9]|[1-9]?[0-9]))?$" }
      ]
    },
    "cidr": {
      "title": "IP CIDR",
      "allOf": [
        { "$ref": "#/definitions/ipAddressOrCIDR" },
        { "pattern": "/[0-9]+$" }
      ]
    },
    "labelSelector": {
      "title": "Kubernetes label selector",
      "type": "object",
      "properties": {
        "matchLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "operator": { "type": "string", "enum": ["In", "NotIn", "Exists", "DoesNotExist"] },
              "values": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["key", "operator"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "networkPolicyPeer": {
      "title": "Kubernetes NetworkPolicyPeer",
      "type": "object",
      "properties": {
        "podSelector": { "$ref": "#/definitions/labelSelector" },
        "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
        "ipBlock": {
          "type": "object",
          "properties": {
            "cidr": { "$ref": "#/definitions/cidr" },
            "except": { "type": "array", "items": { "$ref": "#/definitions/cidr" } }
          },
          "required": ["cidr"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "title": "pod and/or namespace selector",
          "anyOf": [
            { "required": ["podSelector"] },
            { "required": ["namespaceSelector"] }
          ],
          "not": { "required": ["ipBlock"] }
        },
        {
          "title": "IP block",
          "required": ["ipBlock"],
          "not": {
            "anyOf": [
              { "required": ["podSelector"] },
              { "required": ["namespaceSelector"] }
            ]
          }
        }
      ]
    },
    "duration": {
      "title": "Go duration",
      "description": "A positive Go duration: a magnitude and a unit (ns, us, ms, s, m, h), optionally repeated, for example 500ms, 3s, 60s, 720h or 1h30m. Zero is rejected: every interval the collector uses must be positive.",
      "type": "string",
      "pattern": "^([0-9]*[1-9][0-9]*(\\.[0-9]+)?|[0-9]+\\.[0-9]*[1-9][0-9]*)(ns|us|µs|ms|s|m|h)([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*$"
    },
    "promDuration": {
      "title": "Prometheus duration",
      "description": "A Prometheus duration: a magnitude and a unit (ms, s, m, h, d, w, y), optionally repeated, for example 30s, 5m or 1h30m. Zero is rejected.",
      "type": "string",
      "pattern": "^([0-9]*[1-9][0-9]*(ms|s|m|h|d|w|y))+$"
    },
    "alert": {
      "title": "alert rule",
      "description": "One alert of the PrometheusRule. `for` is how long the condition must hold before it fires, `threshold` the number it compares against (ignored by the alerts that compare nothing), and `severity` the label Alertmanager routes on.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "for": { "$ref": "#/definitions/promDuration" },
        "threshold": { "type": "number", "minimum": 0 },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] }
      },
      "required": ["enabled", "for", "severity"],
      "additionalProperties": false
    },
    "callsPerSecond": {
      "title": "JSON-RPC budget",
      "description": "0 means unlimited (a dedicated node). Anything else is a real budget between 0.1 and 10000 calls per second, counting every item inside a batch. A negative value, or one below 0.1, is a mistake rather than a budget: use 0.",
      "type": "number",
      "anyOf": [
        { "title": "unlimited (dedicated node)", "minimum": 0, "maximum": 0 },
        { "title": "0.1 to 10000 calls per second", "minimum": 0.1, "maximum": 10000 }
      ]
    },
    "httpURL": { "type": "string", "pattern": "^https?://[^\\s]+$" },
    "wsURL": {
      "description": "A WebSocket endpoint, which must be ws:// or wss://. An http(s) URL here is rejected by the collector at startup.",
      "type": "string",
      "pattern": "^wss?://[^\\s]+$"
    },
    "endpoint": {
      "title": "fallback endpoint",
      "description": "A further endpoint for the same chain, tried when the active one fails. rpc_url may be omitted only when the collector's environment supplies NETWORK_<NAME>_FALLBACK_RPC_URLS at this position; the templates check that.",
      "type": "object",
      "properties": {
        "rpc_url": { "$ref": "#/definitions/httpURL" },
        "ws_url": { "$ref": "#/definitions/wsURL" },
        "archive": { "type": "boolean" },
        "calls_per_second": { "$ref": "#/definitions/callsPerSecond" }
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Lower-case identifier. It is upper-cased with dashes replaced by underscores to build the NETWORK_<NAME>_* environment overrides, so it may only hold letters, digits and dashes.",
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$"
        },
        "display_name": { "type": "string", "minLength": 1 },
        "chain_id": { "type": "integer", "minimum": 1 },
        "rpc_url": {
          "description": "Primary RPC URL. Omit it only when the collector's environment supplies NETWORK_<NAME>_RPC_URL, which the templates check.",
          "$ref": "#/definitions/httpURL"
        },
        "ws_url": { "$ref": "#/definitions/wsURL" },
        "explorer_url": { "$ref": "#/definitions/httpURL" },
        "calls_per_second": { "$ref": "#/definitions/callsPerSecond" },
        "archive": { "type": "boolean" },
        "history_epoch": {
          "description": "Raise it by one to rebuild this network's reconstructed history once, for example after giving the network an archive endpoint. The collector records the epoch it last rebuilt at, so a restarting pod on the same value rebuilds nothing.",
          "type": "integer",
          "minimum": 0
        },
        "tick_interval": { "$ref": "#/definitions/duration" },
        "enabled": { "type": "boolean" },
        "fallbacks": { "type": "array", "items": { "$ref": "#/definitions/endpoint" } }
      },
      "required": ["name", "chain_id"],
      "additionalProperties": false
    },
    "componentImage": {
      "type": "object",
      "properties": { "repository": { "type": "string", "minLength": 1 } },
      "required": ["repository"],
      "additionalProperties": false
    },
    "componentSecurityContext": {
      "type": "object",
      "properties": {
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": { "type": ["string", "integer", "number"] }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "$ref": "#/definitions/resourceList" },
        "limits": { "$ref": "#/definitions/resourceList" }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "required": ["type", "port"],
      "additionalProperties": false
    },
    "keySelector": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" }
      },
      "required": ["name", "key"],
      "additionalProperties": false
    },
    "envVar": {
      "title": "Kubernetes EnvVar",
      "description": "A name plus exactly one of value and valueFrom. valueFrom holds exactly one of secretKeyRef, configMapKeyRef, fieldRef and resourceFieldRef. A NETWORK_<NAME>_RPC_URL, _WS_URL or _FALLBACK_RPC_URLS override given as a literal must not be empty: internal/config ignores an empty override, so the network would fall back to config.yaml (or to nothing) rather than to the value that was meant.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "^[-._a-zA-Z][-._a-zA-Z0-9]*$" },
        "value": { "type": "string" },
        "valueFrom": {
          "type": "object",
          "properties": {
            "secretKeyRef": { "$ref": "#/definitions/keySelector" },
            "configMapKeyRef": { "$ref": "#/definitions/keySelector" },
            "fieldRef": {
              "type": "object",
              "properties": {
                "apiVersion": { "type": "string", "minLength": 1 },
                "fieldPath": { "type": "string", "minLength": 1 }
              },
              "required": ["fieldPath"],
              "additionalProperties": false
            },
            "resourceFieldRef": {
              "type": "object",
              "properties": {
                "containerName": { "type": "string", "minLength": 1 },
                "resource": { "type": "string", "minLength": 1 },
                "divisor": { "type": ["string", "integer", "number"] }
              },
              "required": ["resource"],
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1
        }
      },
      "required": ["name"],
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            { "title": "value", "required": ["value"], "not": { "required": ["valueFrom"] } },
            { "title": "valueFrom", "required": ["valueFrom"], "not": { "required": ["value"] } }
          ]
        },
        {
          "title": "an RPC or WebSocket URL override given as a literal must not be empty",
          "if": {
            "properties": { "name": { "pattern": "^NETWORK_[A-Za-z0-9_]+_(RPC_URL|WS_URL|FALLBACK_RPC_URLS|FALLBACK_WS_URLS)$" } },
            "required": ["name", "value"]
          },
          "then": { "properties": { "value": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "envVarList": { "type": "array", "items": { "$ref": "#/definitions/envVar" } }
  }
}
