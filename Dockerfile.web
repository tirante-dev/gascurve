# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e

# Base images are pinned by digest; Dependabot (docker ecosystem) bumps them.

# deps: install from the lockfile
FROM node:26-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS deps
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci

# builder: Next.js standalone output
FROM node:26-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS builder
WORKDIR /app
ARG VERSION=0.0.0
ARG NEXT_PUBLIC_SITE_URL=https://gascurve.com
ARG NEXT_PUBLIC_API_URL=/api/v1
ENV NEXT_TELEMETRY_DISABLED=1 \
    APP_VERSION=$VERSION \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
COPY --from=deps /app/node_modules ./node_modules
COPY web/ .
RUN npm run build

# runner
FROM node:26-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS runner
WORKDIR /app
ARG NEXT_PUBLIC_SITE_URL=https://gascurve.com
ARG NEXT_PUBLIC_API_URL=/api/v1
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    HOSTNAME=0.0.0.0 \
    PORT=3000
# Drop the bundled npm, corepack and yarn: the standalone server only needs
# node, and npm's own dependency tree is where the rest of the image's CVEs
# live (brace-expansion, pacote, sigstore, tar). Nothing in this application
# shells out to npm at runtime.
#
# No blanket `apk upgrade` here. It would install whatever the Alpine index
# happens to hold at build time, so the same commit and the same base digest
# would produce a different runtime on a later rebuild. OS patches come from
# bumping the digest-pinned base above, which Dependabot does.
#
# The one package pinned by hand is just as reproducible, because the version
# is exact and a missing version fails the build instead of drifting: the
# newest node:22-alpine (the digest above, Alpine 3.24.1) still ships
# openssl 3.5.7-r0, which Trivy reports as CVE-2026-14456 (HIGH, fixed in
# 3.5.8-r0), and there is no newer base to bump to. With this pin the runtime
# stage has no fixed HIGH or CRITICAL findings at all. Drop the apk add line
# once a base digest with libcrypto3 3.5.8-r0 or newer lands.
RUN apk add --no-cache libcrypto3=3.5.8-r0 libssl3=3.5.8-r0 \
 && rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /opt/yarn* /usr/local/bin/yarn /usr/local/bin/yarnpkg \
 && addgroup -g 1001 -S nodejs && adduser -u 1001 -S nextjs -G nodejs
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
# Numeric UID/GID so Kubernetes can enforce runAsNonRoot.
USER 1001:1001
EXPOSE 3000
CMD ["node", "server.js"]
