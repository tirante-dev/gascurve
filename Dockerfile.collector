# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e

# Base images are pinned by digest; Dependabot (docker ecosystem) bumps them.
FROM golang:1.27-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS builder
WORKDIR /src
ARG VERSION=0.0.0
RUN apk add --no-cache ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/tirante-dev/gascurve/internal/version.Version=${VERSION}" -o /out/gascurve-collector ./cmd/collector \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/tirante-dev/gascurve/internal/version.Version=${VERSION}" -o /out/gascurve-migrate ./cmd/migrate

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
WORKDIR /app
COPY --from=builder /out/gascurve-collector /app/gascurve-collector
COPY --from=builder /out/gascurve-migrate /app/gascurve-migrate
COPY config.yaml /app/config.yaml
# Numeric UID/GID so Kubernetes can enforce runAsNonRoot (distroless nonroot is 65532).
USER 65532:65532
ENTRYPOINT ["/app/gascurve-collector"]
