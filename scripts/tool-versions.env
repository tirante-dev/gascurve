# Go command-line tools used by the Makefile and hosted CI. Keep each package,
# module, and version together so installation and binary validation share one
# source of truth.
GOIMPORTS_PACKAGE=golang.org/x/tools/cmd/goimports
GOIMPORTS_MODULE=golang.org/x/tools
GOIMPORTS_VERSION=v0.49.0

GOLANGCI_LINT_PACKAGE=github.com/golangci/golangci-lint/v2/cmd/golangci-lint
GOLANGCI_LINT_MODULE=github.com/golangci/golangci-lint/v2
GOLANGCI_LINT_VERSION=v2.12.2

STATICCHECK_PACKAGE=honnef.co/go/tools/cmd/staticcheck
STATICCHECK_MODULE=honnef.co/go/tools
STATICCHECK_VERSION=v0.8.1

GOVULNCHECK_PACKAGE=golang.org/x/vuln/cmd/govulncheck
GOVULNCHECK_MODULE=golang.org/x/vuln
GOVULNCHECK_VERSION=v1.7.0
